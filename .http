# The basic request to localhost
@baseUrl = http://localhost:3000
@contentType = application/json

### Basic check
GET {{baseUrl}}

### Get all tasks
GET {{baseUrl}}/tasks

### Get a specific task
GET {{baseUrl}}/tasks/123

### Create a new task
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}

{
  "title": "Learn NestJS",
  "description": "Complete the NestJS Course.",
  "status": "OPEN"
}

### Validation error - status is invalid
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}

{  
  "description": "Complete the NestJS Course.",
  "status": "XXX"
}
