# The basic request to localhost
@baseUrl = http://localhost:3000
@contentType = application/json

### Basic check
GET {{baseUrl}}

### Get all tasks
GET {{baseUrl}}/tasks

### Get a specific task
GET {{baseUrl}}/tasks/{{taskId}}

### Create a new task

# @name createTask
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}

{
  "title": "Learn NestJS",
  "description": "Complete the NestJS Course.",
  "status": "DONE"
}

### set the task id

@taskId = {{ createTask.response.body.id }}

### Validation error - status is invalid
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}

{  
  "description": "Complete the NestJS Course.",
  "status": "XXX"
}


### Update task status
PATCH {{baseUrl}}/tasks/{{taskId}}
Content-Type: {{contentType}}

{  
  "status": "IN_PROGRESS"
}

### Delete a task
DELETE {{baseUrl}}/tasks/{{taskId}}
Content-Type: {{contentType}}
